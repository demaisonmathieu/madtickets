# Frontend
VITE_DB_MODE=hybrid
# Compat legacy (si VITE_DB_MODE absent)
VITE_USE_REMOTE_DB=false
VITE_API_BASE_URL=http://localhost:4000/api

# Frontend distant (exemple VPS)
# VITE_API_BASE_URL=https://vps-48aa0bd2.vps.ovh.net/api

# Backend API
API_PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Backend API sur VPS OVH (exemple)
# FRONTEND_ORIGIN=https://vps-48aa0bd2.vps.ovh.net

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/madtickets
# Set to require when using managed PostgreSQL with SSL
PGSSLMODE=disable

# SMTP (envoi email client depuis un ticket)
SMTP_HOST=smtp.votre-fournisseur.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-utilisateur-smtp
SMTP_PASS=votre-mot-de-passe-smtp
SMTP_FROM="Tickets App <noreply@votredomaine.com>"
